datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         String   @default("CUSTOMER") // CUSTOMER, DRIVER, ADMIN
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  driverProfile     DriverProfile?
  ridesAsCustomer   Ride[]             @relation("CustomerRides")
  savedAddresses    SavedAddress[]
  notifications     Notification[]
  supportTickets    SupportTickets[]
  couponRedemptions CouponRedemption[]
  referralCode      ReferralCode?
  referralsMade     ReferralReward[]   @relation("Referrer")
  referralsReceived ReferralReward[]   @relation("Referee")
  customerRatings   Rating[]           @relation("CustomerRatings")
  activityLogs      ActivityLog[]

  @@index([email])
  @@index([phone])
}

model DriverProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber      String   @unique
  isOnline           Boolean  @default(false)
  isAvailable        Boolean  @default(true)
  isVerified         Boolean  @default(false)
  rating             Float    @default(4.9)
  totalRides         Int      @default(0)
  totalEarningsPaise Int      @default(0)
  currentLat         Float    @default(12.9716) // Default Bangalore center
  currentLng         Float    @default(77.5946)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  vehicle   Vehicle?
  documents DriverDocument[]
  rides     Ride[]           @relation("DriverRides")
  ratings   Rating[]         @relation("DriverRatings")

  @@index([userId])
  @@index([isOnline, isAvailable])
}

model Vehicle {
  id              String        @id @default(uuid())
  driverProfileId String        @unique
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  category        String // BIKE, AUTO, CAB_ECONOMY, CAB_PREMIUM
  make            String
  model           String
  color           String
  plateNumber     String        @unique
  year            Int           @default(2023)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model DriverDocument {
  id              String        @id @default(uuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  docType         String // DRIVING_LICENSE, RC_BOOK, AADHAAR, INSURANCE
  fileUrl         String
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED
  notes           String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([driverProfileId])
}

model Ride {
  id          String         @id @default(uuid())
  bookingCode String         @unique
  customerId  String
  customer    User           @relation("CustomerRides", fields: [customerId], references: [id])
  driverId    String?
  driver      DriverProfile? @relation("DriverRides", fields: [driverId], references: [id])

  pickupAddress String
  pickupLat     Float
  pickupLng     Float
  destAddress   String
  destLat       Float
  destLng       Float

  category        String // BIKE, AUTO, CAB_ECONOMY, CAB_PREMIUM
  distanceKm      Float
  durationMinutes Int

  baseFarePaise     Int
  distanceFarePaise Int
  waitingFarePaise  Int   @default(0)
  surgeMultiplier   Float @default(1.0)
  discountPaise     Int   @default(0)
  totalFarePaise    Int

  status        String    @default("REQUESTED") // REQUESTED, SEARCHING, DRIVER_ASSIGNED, DRIVER_ARRIVING, ARRIVED, IN_PROGRESS, COMPLETED, CANCELLED
  paymentMethod String    @default("CASH") // CASH, RAZORPAY_DEMO, RAZORPAY_LIVE
  paymentStatus String    @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  otp           String    @default("1234")
  cancelReason  String?
  cancelledBy   String? // CUSTOMER, DRIVER, ADMIN, SYSTEM
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  statusEvents   RideStatusEvent[]
  payments       Payment[]
  redemption     CouponRedemption?
  rating         Rating?
  supportTickets SupportTickets[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([bookingCode])
}

model RideStatusEvent {
  id        String   @id @default(uuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  @@index([rideId])
}

model FareRule {
  id                 String   @id @default(uuid())
  category           String   @unique // BIKE, AUTO, CAB_ECONOMY, CAB_PREMIUM
  displayName        String
  description        String
  baseFarePaise      Int
  perKmRatePaise     Int
  minFarePaise       Int
  waitingChargePaise Int      @default(100) // per minute
  surgeMultiplier    Float    @default(1.0)
  capacity           Int      @default(1)
  iconName           String   @default("bike")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  rideId        String
  ride          Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  amountPaise   Int
  currency      String   @default("INR")
  provider      String // CASH, RAZORPAY_DEMO, RAZORPAY_LIVE
  orderId       String?
  transactionId String?
  receiptNumber String   @unique
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  rawResponse   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([rideId])
  @@index([orderId])
}

model Coupon {
  id               String   @id @default(uuid())
  code             String   @unique
  description      String
  discountType     String // PERCENTAGE, FLAT
  discountValue    Int // Percentage or paise
  minOrderPaise    Int      @default(0)
  maxDiscountPaise Int?
  usageLimit       Int      @default(1000)
  timesUsed        Int      @default(0)
  validFrom        DateTime @default(now())
  validUntil       DateTime
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([code])
}

model CouponRedemption {
  id            String   @id @default(uuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  rideId        String   @unique
  ride          Ride     @relation(fields: [rideId], references: [id])
  discountPaise Int
  redeemedAt    DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

model ReferralCode {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code              String   @unique
  timesReferred     Int      @default(0)
  totalRewardsPaise Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ReferralReward {
  id             String   @id @default(uuid())
  referrerUserId String
  referrer       User     @relation("Referrer", fields: [referrerUserId], references: [id])
  refereeUserId  String
  referee        User     @relation("Referee", fields: [refereeUserId], references: [id])
  rewardPaise    Int      @default(5000) // ₹50 reward
  status         String   @default("CREDITED") // PENDING, CREDITED
  createdAt      DateTime @default(now())

  @@index([referrerUserId])
  @@index([refereeUserId])
}

model Rating {
  id         String        @id @default(uuid())
  rideId     String        @unique
  ride       Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  customerId String
  customer   User          @relation("CustomerRatings", fields: [customerId], references: [id])
  driverId   String
  driver     DriverProfile @relation("DriverRatings", fields: [driverId], references: [id])
  score      Int // 1 to 5
  feedback   String?
  tags       String? // comma separated tags like "Polite, On Time, Clean Helmet"
  createdAt  DateTime      @default(now())

  @@index([customerId])
  @@index([driverId])
}

model SavedAddress {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String // HOME, WORK, GYM, OTHER
  title      String
  address    String
  lat        Float
  lng        Float
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("RIDE_UPDATE") // RIDE_UPDATE, PROMO, SYSTEM, SAFETY
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model SupportTickets {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rideId     String?
  ride       Ride?    @relation(fields: [rideId], references: [id])
  category   String // BILLING, SAFETY, DRIVER_BEHAVIOR, APP_ISSUE, LOST_ITEM, OTHER
  subject    String
  message    String
  status     String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority   String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // USER_LOGIN, RIDE_BOOKED, RIDE_CANCELLED, DRIVER_VERIFIED, FARE_UPDATED, etc.
  entityType String // USER, RIDE, DRIVER, FARE, SYSTEM
  entityId   String?
  ipAddress  String?
  metadata   String? // JSON string
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
